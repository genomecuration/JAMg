+cp "$GM_FIXTURE"        "$GM_OUT/genemark.gff3"
+cp "$GM_FIXTURE_SORTED" "$GM_OUT/genemark.gff3.sorted"
+cp "$GM_FIXTURE_GTF"    "$GM_OUT/genemark.gtf"
