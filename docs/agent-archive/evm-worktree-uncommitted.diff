 }
+
+# Phase 1: build the two upstream branches that feed the genemark rule
+# (rnaseq_hints and repeats_merge) in a separate snakemake invocation,
+# without --mtime-only. This gives those outputs current-session timestamps
+# WITHOUT marking them as "updated by another job" in the phase-2 run.
+# Snakemake 9's "updated by another job" tracking is per-invocation: inputs
+# produced in a prior completed invocation are treated as pre-existing files
+# and compared by mtime only, so the 2038 genemark fixture survives the
+# mtime check in phase 2. Running both in one call or in the same
+# invocation as --until evm_run would mark them "updated by another job"
+# and force the genemark rule to re-run regardless of its far-future mtime.
+pixi run "$REPO/bin/jamg" run --config "$CFG" --cores "${SLURM_CPUS_PER_TASK:-20}" --until rnaseq_hints
+pixi run "$REPO/bin/jamg" run --config "$CFG" --cores "${SLURM_CPUS_PER_TASK:-20}" --until repeats_merge
+
+# Assert the load-bearing upstream outputs exist before pre-staging genemark.
+[[ -s "$REPO/test_suite/output/rnaseq/rnaseq.hints" ]] || {
+    echo "FATAL: rnaseq.hints missing after phase-1 rnaseq_hints run" >&2; exit 1
+}
+[[ -s "$REPO/test_suite/output/repeats/mini-genome.fasta.softmasked" ]] || {
+    echo "FATAL: softmasked genome missing after phase-1 repeats_merge run" >&2; exit 1
+}
+
+# Pre-stage the genemark outputs with a mtime 2 seconds in the future relative
+# to now. This must be NEWER than the phase-1 outputs (so snakemake's mtime
+# check skips genemark and evm_tag_genemark), but NOT so far in the future
