+touch -d "@${GM_STAGE_TS}" "$GM_OUT/genemark.gff3" "$GM_OUT/genemark.gff3.sorted" \
+                           "$GM_OUT/genemark.gtf" "$GM_OUT/.preflight.ok"
 
+# Phase 2: run the full downstream chain (augustus, golden, pasa, proteins,
+# evm) with --mtime-only so the pre-staged genemark fixture is not re-run
+# despite having inputs that now exist on disk.
 pixi run "$REPO/bin/jamg" run --config "$CFG" --cores "${SLURM_CPUS_PER_TASK:-20}" --until evm_run --mtime-only
 
+# Verify the genemark fixture was not clobbered: mtime must still be above
+# the pre-stage timestamp.
+gm_mtime=$(stat -c '%Y' "$GM_OUT/genemark.gff3" 2>/dev/null || echo 0)
+if (( gm_mtime < GM_STAGE_TS )); then
+    echo "FATAL: genemark.gff3 was overwritten during phase 2 (mtime reset below pre-stage value)" >&2
+    exit 1
+fi
+
 test -s "$OUT/EVM.gff3" || { echo "EVM.gff3 missing or empty"; exit 1; }
 
