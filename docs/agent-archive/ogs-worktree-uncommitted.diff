index 507cba35..feba61be 100644
--- a/src/jamg/cli.py
+++ b/src/jamg/cli.py
@@ -220,6 +220,59 @@ def run(
         # skips the pre-staged rule. Production runs MUST NOT use this flag
         # (config edits would silently not re-run dependent rules).
         cmd += ["--rerun-triggers", "mtime"]
+        # Genemark cannot run on the 100 kb default fixture (gmes_petap.pl
+        # --ET requires the sequence to be >=~70 kb of unmasked sequence).
+        # When both genemark outputs are pre-staged, the test bypass relies on
+        # snakemake skipping genemark because its outputs are newer (far-future
+        # timestamp) than its inputs. However, snakemake's "updated by another
+        # job" cascade fires within a session even with --rerun-triggers mtime,
+        # so we run a two-pass approach: first build genemark's inputs so they
+        # exist as completed files (not "updated by another job" in the NEXT
+        # session), then run the full pipeline in a second snakemake call.
+        # Separate snakemake invocations don't share the in-session job tracker.
+        outdir = Path(cfg.get("outdir", "")).resolve()
+        gm_dir = outdir / "genemark"
+        if (gm_dir / "genemark.gtf").exists() and (gm_dir / "genemark.gff3").exists():
+            # Pass 1: build only genemark's upstream inputs (rnaseq_hints and
+            # repeats_merge). If they already exist, this is a quick no-op.
+            # NOTE: snakemake positional targets must come LAST, after all
+            # options, because --rerun-triggers takes nargs='+' and would
+            # consume positional-style args that appear immediately after it.
+            pre_cmd = [
+                "snakemake",
+                "--snakefile", str(WORKFLOW / "Snakefile"),
+                "--configfile", config_path,
+                "--rerun-triggers", "mtime",
+            ]
+            if not inside_sif:
+                pre_cmd += [
+                    "--software-deployment-method",
+                    "apptainer",
+                    "--singularity-prefix",
+                    str(REPO / ".snakemake" / "apptainer"),
+                    "--apptainer-args",
+                    bind_args,
+                ]
+            pre_cmd += ["--cores", str(cores), "rnaseq_hints", "repeats_merge"]
+            ret = subprocess.call(pre_cmd, env={**os.environ, "JAMG_CONTAINER_RUNTIME": runtime})
+            if ret != 0:
+                sys.exit(ret)
+            # After pass 1, the genemark upstream inputs (rnaseq.hints,
+            # softmasked) now exist with current timestamps. Update the
+            # pre-staged genemark outputs to be JUST NEWER (+1s) than those
+            # inputs, so that:
+            #   (a) mtime check in pass 2: output (now+1s) > input (now) → skip
+            #   (b) clock-skew check in downstream rules: their outputs are
+            #       created AFTER this touch, so output timestamp > genemark
+            #       timestamp → no clock skew.
+            # The 2038 pre-staged timestamps would cause (b) to fail because
+            # downstream rule outputs (current time) < 2038.
+            import time as _time
+            _new_ts = _time.time() + 1
+            for _f in [gm_dir / "genemark.gtf", gm_dir / "genemark.gff3", gm_dir / ".preflight.ok"]:
+                if _f.exists():
+                    import os as _os2
+                    _os2.utime(str(_f), (_new_ts, _new_ts))
     if not inside_sif:
         # Snakemake 9: --software-deployment-method selects the runtime;
         # --apptainer-args is passed through to apptainer; the cache-prefix
