Bootstrap: docker
From: pasapipeline/pasapipeline:2.5.3

# PASA 2.5.3 SIF, pulled unmodified from the upstream Docker image.
#
# Consumed by workflow/rules/pasa.smk via per-rule `container:` directive.
# Standalone use:
#   apptainer exec containers/pasa.sif Launch_PASA_pipeline.pl --version

# NOTE: no %post block. The upstream pasapipeline:2.5.3 image is built on a
# glibc-2.31 base; apptainer's libfakeroot.so requires GLIBC_2.33+ to run
# under --fakeroot, so any %post would fail at faked startup. The image is
# used as-is; the tmp / apt caches the upstream image carries are cosmetic
# only and do not affect runtime behaviour.

%environment
    export LC_ALL=C.UTF-8

%runscript
    exec Launch_PASA_pipeline.pl "$@"
