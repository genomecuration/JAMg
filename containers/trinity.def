Bootstrap: docker
From: trinityrnaseq/trinityrnaseq:2.15.2

# Trinity 2.15.2 SIF, pulled unmodified from the upstream Docker image. The
# image is the kitchen-sink Trinity build (Trinity + jellyfish + salmon +
# bowtie2 + samtools + JVM + bioconductor R + DE-analysis tools); v2 invokes
# only the genome-guided assembly path but ships the whole image because
# stripping bioconductor would break Trinity's own runtime scripts.
#
# Consumed by workflow/rules/tgg.smk via per-rule `container:` directive.
# Standalone use: `apptainer exec containers/trinity.sif Trinity --version`.

# NOTE: no %post block. The upstream trinityrnaseq:2.15.2 image may be built
# on an older glibc base; apptainer's libfakeroot.so requires GLIBC_2.33+ to
# run under --fakeroot, so any %post would risk failing at faked startup.
# The image is used as-is; the upstream caches are cosmetic only.

%environment
    export LC_ALL=C.UTF-8

%runscript
    exec Trinity "$@"
