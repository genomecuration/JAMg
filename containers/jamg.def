Bootstrap: localimage
From: jamg-base.sif

# JAMg v2 main image, layered on top of jamg-base.sif. Holds:
#   - slim bioconda tool set: minimap2, gmap, samtools, bcftools, bedtools,
#     gffread, htslib, star, repeatmasker, repeatmodeler.
#   - source-built: Augustus, EVidenceModeler, TransDecoder, cdbfasta, ParaFly.
#   - CGP apt deps for the Augustus source build: libgsl-dev,
#     libsuitesparse-dev, liblpsolve55-dev (installed in %post, not in base,
#     so the base SIF stays a lean OS substrate).
#   - bin/ + PerlLib/ glue.
#
# Trinity and PASA live in separate SIFs (containers/trinity.def, pasa.def)
# pulled from upstream Docker. The Snakemake rules use per-rule `container:`
# directives to dispatch to the right SIF.

%setup
    # Pre-create the bind destination for the host RepeatMasker libraries.
    # Apptainer cannot auto-create bind destinations in writable build mode
    # without overlay/underlay support; %setup runs after bootstrap and
    # before %files / %post with $APPTAINER_ROOTFS pointing at the extracted
    # rootfs, so we can mkdir it directly.
    mkdir -p ${APPTAINER_ROOTFS}/rm_lib_host

%files
    environment.yml /opt/environment.yml
    post-install.sh /opt/post-install.sh
    ../bin /opt/jamg/bin
    ../PerlLib /opt/jamg/PerlLib

%post
    # /bin/sh is dash in the trixie base. Dash-safe top-level; bash sub-shell
    # for the conda-activate + source-compile dance.
    set -eux

    # CGP (Augustus Comparative Gene Prediction) build deps. Installed here
    # rather than in jamg-base so the base SIF stays a lean OS substrate;
    # CGP libs are JAMg-specific and consumed only by the Augustus source
    # build below. jamg-base cleaned its apt lists, so refresh them.
    apt-get update
    apt-get install -y --no-install-recommends \
        libgsl-dev libsuitesparse-dev liblpsolve55-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/* \
           /var/cache/apt/archives/*.deb \
           /var/cache/apt/archives/partial/*

    # %environment from the base SIF is NOT propagated into this %post
    # (apptainer build-time isolation). Re-export here.
    export MAMBA_ROOT_PREFIX=/opt/conda

    # micromamba install -n base for the slim bioconda set. Smaller package
    # list -> faster solve (~1-2 min vs ~5+ for the bloated set).
    /usr/local/bin/micromamba install -n base -y -f /opt/environment.yml

    chmod +x /opt/post-install.sh

    # Bash subshell: micromamba shell hook emits bash function definitions
    # that dash cannot parse. The subshell holds the activate + source-build
    # chain. PATH ordering inside the subshell puts /opt/conda/bin first
    # because the bioconda compilers + tools need to be on PATH for the
    # source-compiles to find them.
    /bin/bash -c '
        set -euxo pipefail
        export MAMBA_ROOT_PREFIX=/opt/conda
        export PATH=/opt/conda/bin:$PATH
        eval "$(/usr/local/bin/micromamba shell hook -s bash)"
        micromamba activate base
        bash /opt/post-install.sh
    '

    # Cleanup runs AFTER post-install.sh so activate.d scripts are still in
    # place when source-compiles run.
    /usr/local/bin/micromamba clean -ay
    # Strip __pycache__ + .pyc from the conda env (regenerated at runtime)
    find /opt/conda -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
    find /opt/conda -name '*.pyc' -delete 2>/dev/null || true
    # Strip docs / man / info / locale from the conda env (large for R/python)
    rm -rf /opt/conda/share/doc/* /opt/conda/share/man/* /opt/conda/share/info/* \
           /opt/conda/pkgs/* /opt/conda/conda-meta/history
    find /opt/conda/share/locale -mindepth 1 -maxdepth 1 -type d \
         ! -name 'en*' -exec rm -rf {} + 2>/dev/null || true
    # Tmp + pip cache + any source residue post-install.sh missed.
    # Tolerant rm because /var/tmp may contain systemd-private dirs (owned by
    # other UIDs, fakeroot can't remove them; cleanup is best-effort).
    rm -rf /tmp/* /var/tmp/* /root/.cache /opt/src 2>/dev/null || true
    # /rm_lib_host was the bind-mount target during build; remove the now-empty
    # stub dir so it doesn't appear in the squashed SIF.
    rmdir /rm_lib_host 2>/dev/null || true

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PERL5LIB=/opt/jamg/PerlLib
    # PATH order: /opt/jamg/bin (JAMg scripts) first, then /usr/bin (system
    # perl 5.40 with apt-installed BioPerl + DB_File + helpers) BEFORE
    # /opt/conda/bin. JAMg's bin/*.pl use `#!/usr/bin/env perl` which picks
    # the first perl on PATH; system-perl serves them with the apt module
    # set, avoiding the bioconda perl-bioperl <-> samtools solver conflict.
    # conda-perl from bioconda still exists for tools that explicitly
    # invoke /opt/conda/bin/perl (none of JAMg's bin do).
    export PATH=/opt/jamg/bin:/usr/bin:/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
    export AUGUSTUS_CONFIG_PATH=/opt/jamg/share/Augustus/config

# %runscript is intentionally OMITTED until bin/jamg exists. The SIF is
# meant to be invoked via `apptainer exec containers/jamg.sif <cmd>`.
