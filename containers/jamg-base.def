Bootstrap: docker
From: debian:bookworm-slim

# JAMg v2 BASE image -- thin layer holding apt-installed bootstrap tooling
# (ca-certificates, curl, bzip2, tar, python3) plus a statically-linked
# micromamba binary at /usr/local/bin/micromamba. The full bioconda tool stack
# is layered on top by containers/jamg.def via `Bootstrap: localimage`.
#
# Rationale: condaforge/miniforge3:24.11.3-2's mamba 2.x has its libmambapy
# Python binding linked against libxml2.so.2 (libxml2 2.x ABI), but current
# conda-forge has rolled libxml2 to .so.16 (libxml2 3.x ABI) -- breaking every
# mamba invocation. Using a debian base + statically-linked micromamba binary
# sidesteps the entire conda-package-linkage minefield.

%post
    set -euxo pipefail
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl bzip2 tar python3
    rm -rf /var/lib/apt/lists/*

    # Statically-linked micromamba binary. Tarball layout: bin/micromamba.
    # Extract to /usr/local so /usr/local/bin/micromamba ends up on PATH.
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xj -C /usr/local bin/micromamba
    chmod +x /usr/local/bin/micromamba

    mkdir -p /opt/conda

%environment
    # MAMBA_ROOT_PREFIX is set here so anyone who shells into jamg-base.sif
    # standalone sees it. The child SIF's %post must export it again
    # explicitly -- apptainer does NOT propagate the base SIF's %environment
    # into the child's %post (build-time semantics).
    export MAMBA_ROOT_PREFIX=/opt/conda
    # PATH includes /opt/conda/bin (populated lazily by child SIFs). It does
    # NOT include /opt/jamg/bin because that directory is created only by the
    # child SIF's %files copy (jamg-base.sif standalone has no /opt/jamg/bin
    # -- code-review N1).
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
