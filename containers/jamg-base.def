Bootstrap: docker
From: debian:trixie-slim

# JAMg v2 base image. Consumed by jamg.def via `Bootstrap: localimage`.
# trinity.sif and pasa.sif do not layer on this; they pull upstream Docker.
#
# debian:trixie-slim required for: glibc 2.40 (apptainer libfakeroot needs
# GLIBC_2.38) and a complete debian dev toolchain (glib include paths
# resolve correctly under apt's gcc, unlike conda's gcc_linux-64 which fails
# on glibconfig.h for some packages).
#
# Composition:
#   - apt: bootstrap, build chain, system libs, r-base-core, exonerate,
#     emboss, trf, ncbi-blast+, jellyfish, salmon, bowtie2.
#   - source-build (jamg.def %post): Augustus, EVidenceModeler, TransDecoder,
#     cdbfasta, ParaFly.
#   - slim bioconda (jamg.def %post): minimap2, gmap, samtools, bcftools,
#     bedtools, gffread, htslib, star, repeatmasker, repeatmodeler.
#   - separate SIFs: trinity.sif, pasa.sif (upstream Docker).

%post
    # /bin/sh in trixie is dash. Stick to dash-safe syntax in this %post.
    set -eux

    apt-get update

    # Composition rationale: each grouped block below is a deliberate set.
    # Keep groups together when editing.
    apt-get install -y --no-install-recommends \
        \
        `# bootstrap and download tools` \
        ca-certificates curl wget bzip2 tar xz-utils \
        \
        `# build chain for source-compiled tools in jamg.def %post` \
        build-essential autoconf automake libtool cmake git pkg-config \
        \
        `# runtime languages. r-base-core only (no r-recommended) -- the` \
        `# bioconductor pulls in r-recommended are unused by JAMg.` \
        python3 python3-pip perl r-base-core \
        \
        `# system libraries (Augustus, PASA, TransDecoder, Trinity transitive` \
        `# deps -- linker picks debian versions, one source of truth)` \
        libboost-all-dev libopenblas-dev libsqlite3-dev libxml2-dev \
        libcurl4-openssl-dev liblzma-dev libbz2-dev zlib1g-dev libgomp1 \
        libreadline-dev \
        \
        `# small/stable analytic tools (debian-packaged builds)` \
        exonerate emboss trf ncbi-blast+ \
        \
        `# small read-mapping/k-mer tools used by various downstream rules.` \
        `# blat is intentionally absent: not in debian trixie's apt, and v2` \
        `# PASA uses gmap+minimap2 instead.` \
        jellyfish salmon bowtie2 \
        \
        `# Perl modules used by GeneMark's gmes_petap.pl AND JAMg's bin/*.pl.` \
        `# All run under system-perl 5.40; jamg.def's %environment prepends` \
        `# /usr/bin to PATH so 'env perl' picks system-perl over conda-perl.` \
        `# DB_File is part of perl-modules-* (transitively installed with` \
        `# the perl package); not separately apt-installable.` \
        libyaml-perl libhash-merge-perl libparallel-forkmanager-perl libmce-perl \
        libbio-perl-perl libjson-perl libxml-libxml-perl libxml-simple-perl \
        libwww-perl libstatistics-descriptive-perl libhtml-parser-perl \
        \
        `# misc utilities` \
        sqlite3 less procps

    # Strip apt caches, docs, non-default locales so the base SIF stays lean.
    apt-get autoremove -y --purge
    apt-get clean
    rm -rf /var/lib/apt/lists/* \
           /var/cache/apt/archives/*.deb \
           /var/cache/apt/archives/partial/*
    # Strip docs, man pages, info -- not needed at runtime
    rm -rf /usr/share/doc/* /usr/share/doc-base/* \
           /usr/share/man/* /usr/share/info/* \
           /usr/share/lintian/* /usr/share/linda/*
    # Keep en* locales; drop everything else (saves ~30 MB)
    find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
         ! -name 'en*' -exec rm -rf {} +

    # Statically-linked micromamba binary -- consumed by jamg.def's %post for
    # the slim bioconda install. Tarball layout: bin/micromamba.
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xj -C /usr/local bin/micromamba
    chmod +x /usr/local/bin/micromamba

    mkdir -p /opt/conda

    # Final tmp + pip cache sweep. /var/tmp/systemd-private-* dirs are owned
    # by system services and apptainer's fakeroot can't remove them
    # ("Operation not permitted"). Tolerate that with `|| true` -- the
    # cleanup is best-effort anyway.
    rm -rf /tmp/* /var/tmp/* /root/.cache 2>/dev/null || true

%environment
    # MAMBA_ROOT_PREFIX visible to anyone shelling into jamg-base.sif standalone.
    # Child SIF (jamg.def) re-exports it in %post (apptainer does not
    # propagate %environment into the child's %post).
    export MAMBA_ROOT_PREFIX=/opt/conda
    # PATH does NOT include /opt/jamg/bin here -- that directory is populated
    # only by jamg.def's %files copy. Base SIF is meant to be a build
    # substrate, not a runtime; this PATH keeps it useful for shell-in
    # debugging without lying about contents.
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
